{
    "permissions": {
        "deny": [
            "Read(./.env)",
            "Read(./.env.*)",
            "Read(./**/.env)",
            "Read(./**/.env.*)",
            "Read(./secrets/**)",
            "Edit(./.env)",
            "Edit(./**/.env)",
            "Edit(./secrets/**)",
            "Write(./.env)",
            "Write(./**/.env)",
            "Write(./secrets/**)",

            "Read(./**/*.db)",
            "Read(./**/*.db-wal)",
            "Read(./**/*.db-shm)",
            "Read(./data/**)",
            "Read(./**/*.pem)",
            "Read(./**/*.key)",

            "Bash(* .env*)",
            "Bash(*/.env*)",
            "Bash(cat *.env*)",
            "Bash(cat *.env)",
            "Bash(type *.env*)",
            "Bash(head *.env*)",
            "Bash(tail *.env*)",
            "Bash(less *.env*)",
            "Bash(more *.env*)",
            "Bash(grep * *.env*)",
            "Bash(sed * *.env*)",
            "Bash(awk * *.env*)",
            "Bash(source *.env*)",
            "Bash(. *.env*)",
            "Bash(sqlite3 *)",
            "Bash(docker compose config*)",
            "Bash(docker-compose config*)",
            "Bash(docker inspect *)",
            "Bash(docker compose exec * env*)",
            "Bash(docker exec * env*)",
            "Bash(printenv*)",
            "Bash(env)",

            "PowerShell(Get-Content *.env*)",
            "PowerShell(gc *.env*)",
            "PowerShell(cat *.env*)",
            "PowerShell(type *.env*)",
            "PowerShell(Select-String * *.env*)",
            "PowerShell(* .env*)",
            "PowerShell(*.env*)",
            "PowerShell(docker compose config*)",
            "PowerShell(docker inspect *)",
            "PowerShell(Get-ChildItem Env:*)",

            "Bash(git push --force:*)",
            "Bash(git push -f:*)",
            "Bash(git reset --hard:*)",
            "Bash(git push origin main:*)"
        ],
        "allow": [
            "Read(./.env.example)",
            "Bash(pnpm lint:*)",
            "Bash(pnpm typecheck:*)",
            "Bash(pnpm test:*)",
            "Bash(pnpm build:*)",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)"
        ]
    }
}

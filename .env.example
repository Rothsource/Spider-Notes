# Copy to .env and fill in. Never commit .env.

# ---- Required ----

# Username and password of the single account. Only used on first start,
# when no user exists yet. Change the password later in Settings.
APP_ADMIN_USERNAME=me
APP_ADMIN_PASSWORD=change-me-to-something-long

# Secret used to sign session cookies (at least 32 characters).
# Generate one with:  openssl rand -base64 48
APP_SESSION_SECRET=

# ---- Telegram (optional; the app works without it) ----

# Bot token from @BotFather, e.g. 123456789:AAH...
TELEGRAM_BOT_TOKEN=
# The ONLY chat that receives reminders and may press buttons (your user id).
TELEGRAM_CHAT_ID=
# Once you save Telegram settings in the web UI, the database values win over these.

# ---- Optional (defaults shown) ----

# HTTP listen address inside the container.
APP_LISTEN=:8080
# SQLite database file (keep it on the /data volume).
APP_DB_PATH=/data/app.db
# All scheduling and display happen in this time zone.
APP_TIMEZONE=Asia/Phnom_Penh
# Log out after this much inactivity (Go duration: 30m, 12h, 168h...).
APP_SESSION_IDLE_TIMEOUT=12h
# How often the scheduler checks for due reminders.
APP_SCHEDULER_INTERVAL=30s
# Where "Export to Markdown" writes files.
APP_EXPORT_DIR=/data/export
# Set to true only behind a reverse proxy you control (honours X-Forwarded-For
# for login rate limiting and X-Forwarded-Proto=https for Secure cookies).
APP_TRUST_PROXY=false
# debug | info | warn | error
APP_LOG_LEVEL=info
